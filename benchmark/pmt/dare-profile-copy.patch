 using std::to_string;
 
+// Experimental switches are opt-in; profiling inserts barriers and is not a benchmark.
+static bool dare_enabled(const char *name) {
+    const char *value = getenv(name);
+    return value && strcmp(value, "1") == 0;
+}
+
+static int dare_copy(CHAM_desc_t *src, CHAM_desc_t *dst,
+                     RUNTIME_sequence_t *sequence, RUNTIME_request_t *request) {
+    if (dare_enabled("DARE_GPU_COPY")) {
+        // dgeadd has a CUDA implementation; beta=0 declares write-only destination.
+        return CHAMELEON_dgeadd_Tile_Async(ChamNoTrans, 1.0, src, 0.0, dst, sequence, request);
+    }
+    return CHAMELEON_dlacpy_Tile_Async(ChamUpperLower, src, dst, sequence, request);
+}
+
+
 static void get_thread_count(int *thrdnbr) {
     *thrdnbr = sysconf(_SC_NPROCESSORS_ONLN);
 }
