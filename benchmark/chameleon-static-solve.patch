--- a/runtime/starpu/codelets/codelet_zgemm.c
+++ b/runtime/starpu/codelets/codelet_zgemm.c
@@ -78,6 +78,43 @@
     dare_gemm_words = words;
     fprintf(stderr, "DARE static DGEMM GPU owners: %d %d %d %d\n",
             devices[0], devices[1], devices[2], devices[3]);
+}
+
+static pthread_once_t dare_solve_once = PTHREAD_ONCE_INIT;
+static unsigned dare_solve_policy;
+
+static void dare_solve_init_policy(void)
+{
+    const char *trsm = getenv("DARE_STATIC_TRSM");
+    const char *lu = getenv("DARE_STATIC_LU");
+    if (trsm != NULL && strcmp(trsm, "1") == 0) dare_solve_policy |= 1;
+    if (lu != NULL && strcmp(lu, "1") == 0) dare_solve_policy |= 2;
+    if (dare_solve_policy == 0) return;
+    pthread_once(&dare_gemm_once, dare_gemm_init_owners);
+    if (dare_gemm_words == 0) {
+        fprintf(stderr, "DARE_STATIC_TRSM/LU require DARE_STATIC_GEMM=1\n");
+        abort();
+    }
+    fprintf(stderr, "DARE static solve placement: TRSM=%u LU=%u\n",
+            !!(dare_solve_policy & 1), !!(dare_solve_policy & 2));
+}
+
+/* Reuse GEMM's actual worker masks, including both workers on each GPU.
+ * kind=1: TRSM output B, kind=2: cuSOLVER LU output A.
+ * The caller must honor any explicit worker selected by the application.
+ * All operations still use FP64 and the original task dependencies. */
+void dare_static_solve_owner(const CHAM_desc_t *desc, int m, int n,
+                             unsigned kind, unsigned *words, uint32_t **workers)
+{
+    *words = 0;
+    *workers = NULL;
+    pthread_once(&dare_solve_once, dare_solve_init_policy);
+    if ((dare_solve_policy & kind) == 0) return;
+    const int row = desc->i / desc->mb + m;
+    const int col = desc->j / desc->nb + n;
+    const int owner = 2 * (row % 2) + col % 2;
+    *words = dare_gemm_words;
+    *workers = dare_gemm_masks[owner];
 }
 #endif
 
