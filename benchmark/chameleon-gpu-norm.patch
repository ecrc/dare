 #include "chameleon_starpu.h"
 #include "runtime_codelet_z.h"
 
+#if defined(CHAMELEON_DARE_GPU_NORM) && defined(PRECISION_d)
+extern size_t dare_gpu_norm_scratch_size(void);
+extern cudaError_t dare_gpu_tile_sumsq(int m, int n, const double *a, int ld,
+                                       double *pair, void *scratch, cudaStream_t stream);
+
+static void *dare_gpu_norm_scratch[STARPU_NMAXWORKERS];
+
+void dare_gpu_norm_cleanup(void *unused)
+{
+    (void)unused;
+    void **scratch = &dare_gpu_norm_scratch[starpu_worker_get_id()];
+    if (*scratch != NULL) {
+        cudaFree(*scratch);
+        *scratch = NULL;
+    }
+}
+
+static void cl_dare_gpu_norm_cuda_func(void *descr[], void *cl_arg)
+{
+    cham_store_t storev;
+    int m, n;
+    RUNTIME_sequence_t *sequence;
+    RUNTIME_request_t *request;
+    CHAM_tile_t *tileA = cti_interface_get(descr[0]);
+    CHAM_tile_t *tileW = cti_interface_get(descr[1]);
+
+    starpu_codelet_unpack_args(cl_arg, &storev, &m, &n, &sequence, &request);
+    // A worker enqueues all of its tile reductions on the same CUDA stream.
+    void **scratch = &dare_gpu_norm_scratch[starpu_worker_get_id()];
+    cudaError_t status = cudaSuccess;
+    if (*scratch == NULL) {
+        status = cudaMalloc(scratch, dare_gpu_norm_scratch_size());
+    }
+    if (status == cudaSuccess) {
+        status = dare_gpu_tile_sumsq(m, n, tileA->mat, tileA->ld, tileW->mat,
+                                     *scratch, starpu_cuda_get_local_stream());
+    }
+    if (status != cudaSuccess) {
+        fprintf(stderr, "DARE CUDA tile norm failed: %s\n", cudaGetErrorString(status));
+        if (sequence->status == CHAMELEON_SUCCESS) {
+            RUNTIME_sequence_flush(NULL, sequence, request, CHAMELEON_ERR_UNEXPECTED);
+        }
+    }
+}
+
+CODELETS_ALL(dare_gpu_norm, NULL, cl_dare_gpu_norm_cuda_func, STARPU_CUDA, STARPU_CUDA_ASYNC)
+#endif
