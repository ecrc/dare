--- /dev/null
+++ b/runtime/starpu/codelets/dare_gpu_norm.cu
@@ -0,0 +1,79 @@
+#include <cub/block/block_reduce.cuh>
+#include <cuda_runtime.h>
+
+namespace {
+
+constexpr int threads = 128;
+constexpr int blocks = 32;
+
+struct ScaledSum {
+    double scale;
+    double squares;
+};
+
+// A pair represents scale^2 * squares without forming scale^2.
+struct MergeScaledSum {
+    __device__ ScaledSum operator()(ScaledSum a, ScaledSum b) const
+    {
+        if (isnan(a.scale)) return a;
+        if (isnan(b.scale)) return b;
+        if (a.scale == b.scale) return {a.scale, a.squares + b.squares};
+        if (a.scale < b.scale) {
+            const double ratio = a.scale / b.scale;
+            return {b.scale, fma(a.squares, ratio * ratio, b.squares)};
+        }
+        const double ratio = b.scale / a.scale;
+        return {a.scale, fma(b.squares, ratio * ratio, a.squares)};
+    }
+};
+
+using BlockReduce = cub::BlockReduce<ScaledSum, threads>;
+
+__global__ void tile_partials(int m, size_t count, const double *a, int ld,
+                              ScaledSum *partials)
+{
+    __shared__ BlockReduce::TempStorage reduction;
+    ScaledSum sum{0.0, 0.0};
+    const size_t stride = gridDim.x * blockDim.x;
+    for (size_t i = blockIdx.x * blockDim.x + threadIdx.x; i < count; i += stride) {
+        const size_t offset = ld == m ? i : (i / m) * ld + i % m;
+        const double magnitude = fabs(a[offset]);
+        sum = MergeScaledSum{}(sum, {magnitude, 1.0});
+    }
+    sum = BlockReduce(reduction).Reduce(sum, MergeScaledSum{});
+    if (threadIdx.x == 0) partials[blockIdx.x] = sum;
+}
+
+__global__ void finish_tile(const ScaledSum *partials, double *pair)
+{
+    __shared__ BlockReduce::TempStorage reduction;
+    ScaledSum sum = threadIdx.x < blocks ? partials[threadIdx.x] : ScaledSum{0.0, 0.0};
+    sum = BlockReduce(reduction).Reduce(sum, MergeScaledSum{});
+    if (threadIdx.x == 0) {
+        sum = MergeScaledSum{}({pair[0], pair[1]}, sum);
+        // Keep a nonfinite tile visible to the existing CPU reduction.
+        if (isnan(sum.scale)) sum = {1.0, sum.scale};
+        pair[0] = sum.scale;
+        pair[1] = sum.squares;
+    }
+}
+
+} // namespace
+
+extern "C" size_t dare_gpu_norm_scratch_size(void)
+{
+    return blocks * sizeof(ScaledSum);
+}
+
+extern "C" cudaError_t dare_gpu_tile_sumsq(int m, int n, const double *a, int ld,
+                                          double *pair, void *scratch, cudaStream_t stream)
+{
+    if (m == 0 || n == 0) return cudaSuccess;
+
+    auto *partials = static_cast<ScaledSum *>(scratch);
+    tile_partials<<<blocks, threads, 0, stream>>>(m, static_cast<size_t>(m) * n, a, ld, partials);
+    const cudaError_t status = cudaGetLastError();
+    if (status != cudaSuccess) return status;
+    finish_tile<<<1, threads, 0, stream>>>(partials, pair);
+    return cudaGetLastError();
+}
